# Local development only. Production values are documented in deploy/README.md.
STUDIO_DEBUG=1
GENERATION_PROVIDER=mock
# Internal credit billing is paused while the platform is being built.
CREDITS_ENABLED=0
# Optional tariffs used only with CREDITS_ENABLED=1.
CREDITS_PER_SECOND=1
CREDITS_PER_IMAGE=1
# Image studio storage: 1 keeps new images in S3; 0 uses temporary Railway Redis bytes.
SAVE_IMAGES_TO_S3=1
IMAGE_REFERENCE_TTL_SECONDS=3600
IMAGE_DOWNLOAD_TTL_SECONDS=600
# Optional dedicated ephemeral Redis; otherwise uses REDIS_URL.
# IMAGE_TEMP_REDIS_URL=redis://temporary-images.railway.internal:6379/0
# Export these values in the shell; Django deliberately does not auto-load .env.
# DATABASE_URL=postgresql://studio:LOCAL_PASSWORD@localhost:5432/studio
# REDIS_URL=redis://localhost:6379/0
